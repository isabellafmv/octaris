<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for the main Octaris executable (Electron's main
  process). Everything not listed here stays locked down.
-->
<plist version="1.0">
  <dict>
    <!-- V8 compiles JavaScript to machine code at runtime (MAP_JIT memory) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Camera access through getUserMedia. The hardened runtime blocks the
         camera without it, even after the user allows it; goes with
         NSCameraUsageDescription in electron-builder.yml -->
    <key>com.apple.security.device.camera</key>
    <true/>
  </dict>
</plist>
