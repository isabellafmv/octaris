<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for the Electron helper apps (renderer, GPU,
  plugin, utility processes) and the rest of Electron's nested code.
  The backend has its own file: entitlements.backend.plist.
-->
<plist version="1.0">
  <dict>
    <!-- V8 runs in the renderer helpers too -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Chromium opens the camera in a helper (video capture service) -->
    <key>com.apple.security.device.camera</key>
    <true/>
  </dict>
</plist>
